#!/usr/bin/env bash
# Temp file to capture the picker output
tmpfile=$(mktemp)

trapcmd() {
  rm -f "$tmpfile"
}
trap trapcmd exit INT SIGINT

copy-cmd() {
  if [[ -n "${WAYLAND_DISPLAY}" ]]; then
    wl-copy
  else
    xclip
  fi
}

command-exists() {
  command -v "$@" >/dev/null 2>&1
}

## debug
# export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
# export DISPLAY="${DISPLAY:-}"
# export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
# echo "PID: $$" >>/tmp/qute-rbw-debug.log

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
picker="${script_dir}/qute-rbw-picker"

# TODO: make a dynamic terminal var
# # Fix right now is the awesome `wm-term` application, written by myself :)

if command-exists wm-term; then
  wm-term "$picker" "$tmpfile" &
else
  kitty --class qutebrowser-rbw -e "$picker" "$tmpfile" &
fi
pid=$!

# Wait for kitty (the picker session) to finish
wait $pid || true
kill -0 $pid 2>/dev/null && kill -9 $pid

# Read password and TOTP from tmpfile
mapfile -t lines <"$tmpfile"
pass="${lines[0]}"
totp="${lines[1]}"

# Send text to qutebrowser
echo "insert-text $pass" >>"$QUTE_FIFO"

# Copy TOTP if present
if [[ -n "${totp}" ]]; then
  echo "${totp}" | copy-cmd &
  disown
fi

rm -f "$tmpfile"

