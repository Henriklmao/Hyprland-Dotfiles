#!/usr/bin/env bash
# Temp file to capture the picker output
tmpfile=$(mktemp)

trapcmd() {
  rm -f "$tmpfile"
}
trap trapcmd exit INT SIGINT

copy-cmd() {
  if [[ -n "${WAYLAND_DISPLAY}" ]]; then
    wl-copy
  else
    xclip
  fi
}

command-exists() {
  command -v "$@" >/dev/null 2>&1
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
picker="${script_dir}/qute-rbw-picker"

if command-exists wm-term; then
  wm-term "$picker" "$tmpfile" &
else
  kitty --class qutebrowser-rbw -e "$picker" "$tmpfile" &
fi
pid=$!

# Wait for the picker to finish
wait $pid || true
kill -0 $pid 2>/dev/null && kill -9 $pid

# Read output from tmpfile
mapfile -t lines <"$tmpfile"
action="${lines[0]}"

if [[ "$action" == "both" ]]; then
  # Both: username on line 2, password on line 3, optional totp on line 4
  username="${lines[1]}"
  password="${lines[2]}"
  totp="${lines[3]}"

  # Insert username into qutebrowser
  echo "insert-text $username" >>"$QUTE_FIFO"
  sleep 0.2
  # Tab to next field
  echo "fake-key <Tab>" >>"$QUTE_FIFO"
  sleep 0.2
  # Insert password
  echo "insert-text $password" >>"$QUTE_FIFO"
  sleep 0.2
  # Return to insert mode
  echo "insert-mode" >>"$QUTE_FIFO"
  sleep 0.3

  # Copy TOTP if present
  if [[ -n "${totp}" ]]; then
    echo "${totp}" | copy-cmd &
    disown
  fi
else
  # Single value: password or username or otp
  pass="${lines[0]}"
  totp="${lines[1]}"

  # Send text to qutebrowser
  echo "insert-text $pass" >>"$QUTE_FIFO"

  # Copy TOTP if present
  if [[ -n "${totp}" ]]; then
    echo "${totp}" | copy-cmd &
    disown
  fi
fi

rm -f "$tmpfile"
