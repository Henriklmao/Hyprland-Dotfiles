" Tridactyl Firefox addon config
" refer to manual: https://github.com/tridactyl/tridactyl/wiki


" Yank git clone ssh
bind yG composite js "git clone " + document.location.href.replace(/https?:\/\//,"git@").replace("/",":").replace(/$/,".git") | clipboard yank
" Yank git clone https
bind yg composite js "git clone " + document.location.href.replace(/\/$/, ".git") | clipboard yank


" ---------------------------------------------------------------------------
" qutebrowser-like keybinds
" ---------------------------------------------------------------------------

" t / T: unbind the tabopen binds (t = prompt, T = current URL in new tab)
unbind t
unbind T

" O: URL prompt, but open it in a new tab (o stays in the current tab)
bind O fillcmdline tabopen

" yo / yO: open / tabopen with the current URL pre-filled
bind yo current_url open
bind yO current_url tabopen

" Close tabs with dd only - d on its own is disabled
unbind d
bind dd tabclose

" u: restore the last closed tab (or the last closed window)
bind u undo
bind U undo window

" M: toggle bookmark for the current page
bind M bmark

" m: named quickmark in qutebrowser style.
" Tridactyl natively only supports quickmarks on single keys. Named
" quickmarks are therefore stored as bookmarks with the "qm:" prefix.
" b / B show them via bookmark completion (current / new tab).
bind m fillcmdline qmsave
bind b fillcmdline_notrail bmarks qm:
bind B fillcmdline_notrail bmarks -t qm:

" Marks (default: m) remain available under gm
bind gm gobble 1 markadd

" Save quickmark: qmsave <name>
command qmsave jsb -d@ (async () => { const name = JS_ARGS.slice(1).join(" ").trim(); if (!name) return; const [tab] = await browser.tabs.query({ active: true, currentWindow: true }); const title = "qm:" + name; const old = await browser.bookmarks.search({ title }); for (const b of old) if (b.title === title) await browser.bookmarks.remove(b.id); await browser.bookmarks.create({ url: tab.url, title }); })()@

" Delete quickmark: qmdel <name>
command qmdel jsb -d@ (async () => { const title = "qm:" + JS_ARGS.slice(1).join(" ").trim(); const found = await browser.bookmarks.search({ title }); for (const b of found) if (b.title === title) await browser.bookmarks.remove(b.id); })()@

" ---------------------------------------------------------------------------
" Dark Reader
" ---------------------------------------------------------------------------

" td: toggle Dark Reader on/off for the current page.
" Dark Reader does not expose an API to other add-ons, so we send the
" shortcut configured in Dark Reader (default: Alt+Shift+D) to Firefox.
" Requires the Tridactyl native messenger and wtype (Wayland).
bind td exclaim_quiet wtype -M alt -M shift -k d -m shift -m alt
